{
  "name": "@yeesy369/dsh-browser-settings",
  "version": "0.1.1",
  "type": "module",
  "description": "DSH 侧栏面板：可视化配置 dsh-browser-playwright 的窗口模式与反检测补丁（windowVisibility / stealth）。",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test-host.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
